# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(
      task: "bundle",
      build_type: "release",
    )
    # masto.nyc fork: internal first, then promote. Internal testers get the build immediately,
    # with no review wait, which is the only way to check a release on a real phone before the
    # public sees it. Promotion copies rather than moves (supply's promote_track only writes the
    # destination track), so internal keeps the build afterwards.
    validate_only = ENV["PLAY_VALIDATE_ONLY"] == "true"
    upload_to_play_store(
      track: "internal",
      release_status: "completed",
      aab: ENV["AAB_PATH"] || "mastodon/build/outputs/bundle/release/mastodon-release.aab",
      skip_upload_apk: true,
      mapping: ENV["MAPPING_PATH"] || "mastodon/build/outputs/mapping/release/mapping.txt",
      validate_only: validate_only,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # A validated upload was never created, so there is nothing on internal to promote. The
    # promotion is exercised by the next real release, and by the promote lane.
    next if validate_only

    # An internal-only release is the test build path: it goes to the internal testers and stops
    # there. The upload above already put it on internal as completed, so there is nothing to
    # promote, and promoting internal to internal would only risk moving a release that is fine.
    next if (ENV["PLAY_TRACK"] || "production") == "internal"

    tag = ENV.fetch("RELEASE_TAG")
    major, minor, patch = tag.delete_prefix("v").split(".").map { |n| Integer(n) }
    upload_to_play_store(
      track: "internal",
      track_promote_to: ENV["PLAY_TRACK"] || "production",
      track_promote_release_status: ENV["PLAY_RELEASE_STATUS"] || "completed",
      # Internal carries older releases too, so name the one to promote.
      version_code: major * 1_000_000 + minor * 1_000 + patch,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      # A promotion carries the notes the build was uploaded with, which for an automatic build
      # of main are commit subjects. That is the right register for testers and the wrong one for
      # the store, so a promotion to a public track can replace them from
      # changelogs/<versionCode>.txt. Off by default: most promotions should not rewrite history.
      skip_upload_changelogs: ENV["PLAY_UPLOAD_NOTES"] != "true",
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # masto.nyc fork: promotes a build already uploaded to Play, without rebuilding or re-uploading
  # it. A versionCode can only be uploaded once, so a draft that needs to go live has to be
  # promoted rather than released again. Driven by .github/workflows/promote-play-release.yml.
  desc "Promote a build already on Play to a release status"
  lane :promote do
    track = ENV["PLAY_TRACK"] || "production"
    promote_to = ENV["PLAY_PROMOTE_TO"]
    options = {
      track: track,
      version_code: Integer(ENV.fetch("PLAY_VERSION_CODE")),
      track_promote_release_status: ENV["PLAY_RELEASE_STATUS"] || "completed",
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "true",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      # A promotion does not carry release notes. Google's promote call moves a release between
      # tracks and nothing else, so asking supply to upload changelogs alongside it does nothing
      # at all -- it reported success and left production showing a commit subject. Notes have to
      # be written by updating the release in place, which is what omitting track_promote_to
      # below does.
      skip_upload_changelogs: ENV["PLAY_UPLOAD_NOTES"] != "true",
      skip_upload_images: true,
      skip_upload_screenshots: true
    }
    # With no destination track this updates the release already on `track` rather than moving
    # one, which is the only way to change what a live release says.
    if promote_to && !promote_to.empty? && promote_to != "none"
      # Changing the status of a release already on a track is a promotion, even when the
      # destination track is the one it is already on. release_status only applies when a binary
      # is being uploaded: passing it here reported success and changed nothing, leaving 1004 a
      # draft on production while fastlane said the upload finished.
      options[:track_promote_to] = promote_to
    end
    upload_to_play_store(**options)
  end

  lane :beta do
     gradle(
      task: "bundle",
      build_type: "beta",
    )
    upload_to_play_store(
      track: "internal",
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    upload_to_play_store(
	  track: "internal",
	  track_promote_to: "beta",
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true
    )
  end
end
