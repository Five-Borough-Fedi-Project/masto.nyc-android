# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(
      task: "bundle",
      build_type: "release",
    )
    # Track and status are configurable so going live is a repo-variable change rather than a
    # code change.
    #
    # Defaults are deliberately conservative. Upstream's lane had no track at all, which means
    # production, and the store listing still carries upstream's screenshots. And until this app
    # has had one production release, Play treats it as a "draft app" and the API rejects anything
    # that is not release_status draft, which is the error this replaced.
    #
    # Once the listing is ready and a production release exists, set PLAY_TRACK=production and
    # PLAY_RELEASE_STATUS=completed as repository variables.
    upload_to_play_store(
      track: ENV["PLAY_TRACK"] || "internal",
      release_status: ENV["PLAY_RELEASE_STATUS"] || "draft",
      # masto.nyc fork: name the bundle rather than letting supply search for artifacts. It
      # collects every APK the build produced, and one stray APK next to the bundle fails the
      # upload with "Cannot provide both apk(s) and aab". That broke the v0.1.3 release.
      aab: ENV["AAB_PATH"] || "mastodon/build/outputs/bundle/release/mastodon-release.aab",
      skip_upload_apk: true,
      # masto.nyc fork: send the mapping so Play Console deobfuscates crashes.
      mapping: ENV["MAPPING_PATH"] || "mastodon/build/outputs/mapping/release/mapping.txt",
      # masto.nyc fork: PLAY_VALIDATE_ONLY=true checks the upload against Play and publishes
      # nothing, so the pipeline can be tested without burning a versionCode.
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "true",
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
  lane :beta do
     gradle(
      task: "bundle",
      build_type: "beta",
    )
    upload_to_play_store(
      track: "internal",
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    upload_to_play_store(
	  track: "internal",
	  track_promote_to: "beta",
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true
    )
  end
end
