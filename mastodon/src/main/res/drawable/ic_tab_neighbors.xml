<?xml version="1.0" encoding="utf-8"?>
<!-- masto.nyc fork: the local timeline tab. A New Yorker already lives in a building, so the
     greater community is buildings of buildings, against Home's single apartment block. Material
     publishes no distinct filled variant for location_city, so the selected state reads through
     @color/tab_bar_icon and the tab background, as the labels do. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:drawable="@drawable/ic_city_of_cities_24px"/>
</selector>
