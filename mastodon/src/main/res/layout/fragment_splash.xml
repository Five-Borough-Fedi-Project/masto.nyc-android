<?xml version="1.0" encoding="utf-8"?>
<org.joinmastodon.android.ui.views.SizeListenerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fitsSystemWindows="true"
	android:clipToPadding="false"
	android:background="#69C0FF"
	android:theme="@style/Theme.Mastodon.Dark.SplashFragment">

	<!-- masto.nyc fork: upstream's art is five pieces positioned by hand inside a 360x640dp box,
	     scaled to the screen width, with flat colour fills above and below it. Ours is four
	     full-bleed layers drawn at 1440x3040, so they are stacked edge to edge and cropped to
	     whatever the screen actually is. Each one is 24dp larger than the screen on every side so
	     the parallax never drags an edge into view. Back to front: sky, skyline, river, riverbank.
	     A fifth layer is still to come from the artist; nothing here assumes how many there are. -->
	<FrameLayout
		android:id="@+id/art_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<ImageView
			android:id="@+id/art_sky"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_margin="-24dp"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_art_sky"/>

		<ImageView
			android:id="@+id/art_skyline"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_margin="-24dp"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_art_skyline"/>

		<ImageView
			android:id="@+id/art_river"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_margin="-24dp"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_art_river"/>

		<ImageView
			android:id="@+id/art_foreground"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_margin="-24dp"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_art_foreground"/>

	</FrameLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:orientation="vertical">
		
		<!-- masto.nyc fork: 300x129dp matches the 5BFP lockup's 2.32:1, so fitCenter doesn't
		     letterbox it. Upstream's Mastodon wordmark was 3.86:1 at 300x78dp. -->
		<ImageView
			android:layout_width="300dp"
			android:layout_height="129dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="32dp"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_logo"/>

		<Space
			android:layout_width="1px"
			android:layout_height="0px"
			android:layout_weight="1"/>

		<org.joinmastodon.android.ui.views.ProgressBarButton
			android:id="@+id/btn_join_default_server"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:layout_marginRight="16dp"
			style="@style/Widget.Mastodon.M3.Button.Filled"
			tools:text="@string/join_default_server"/>

		<Button
			android:id="@+id/btn_log_in"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:layout_marginRight="16dp"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="8dp"
			android:textColor="#FFF"
			style="@style/Widget.Mastodon.M3.Button.Outlined"
			android:background="@drawable/bg_button_m3_outlined_white"
			android:text="@string/log_in"/>

	</LinearLayout>

</org.joinmastodon.android.ui.views.SizeListenerFrameLayout>