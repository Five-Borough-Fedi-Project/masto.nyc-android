<?xml version="1.0" encoding="utf-8"?>
<org.joinmastodon.android.ui.views.SizeListenerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fitsSystemWindows="true"
	android:clipToPadding="false"
	android:background="#69C0FF"
	android:theme="@style/Theme.Mastodon.Dark.SplashFragment">

	<!-- masto.nyc fork: upstream's art is five pieces positioned by hand inside a 360x640dp box,
	     scaled to the screen width, with flat colour fills above and below it. Ours is four
	     full-bleed layers drawn at 1440x3040, so they are stacked edge to edge and cropped to
	     whatever the screen actually is. Each one is drawn past every edge of the screen by
	     @dimen/splash_art_overhang so the parallax never drags an edge into view. Back to front:
	     sky, skyline, river, riverbank. A fifth layer is still to come from the artist; nothing
	     here assumes how many there are.

	     The overhang is applied per side, not with android:layout_margin. That attribute silently
	     drops a negative value, because MarginLayoutParams reads it with -1 meaning "unset" and
	     only applies it when it is at least 0. So the shorthand left every layer at exactly screen
	     size with no overhang at all, and the smallest movement showed an edge. The per-side
	     attributes have no such check. SplashArtOverhangTest fails if the overhang ever stops
	     covering the travel. -->
	<FrameLayout
		android:id="@+id/art_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<ImageView
			android:id="@+id/art_sky"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginLeft="@dimen/splash_art_overhang"
			android:layout_marginTop="@dimen/splash_art_overhang"
			android:layout_marginRight="@dimen/splash_art_overhang"
			android:layout_marginBottom="@dimen/splash_art_overhang"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_art_sky"/>

		<ImageView
			android:id="@+id/art_skyline"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginLeft="@dimen/splash_art_overhang"
			android:layout_marginTop="@dimen/splash_art_overhang"
			android:layout_marginRight="@dimen/splash_art_overhang"
			android:layout_marginBottom="@dimen/splash_art_overhang"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_art_skyline"/>

		<ImageView
			android:id="@+id/art_river"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginLeft="@dimen/splash_art_overhang"
			android:layout_marginTop="@dimen/splash_art_overhang"
			android:layout_marginRight="@dimen/splash_art_overhang"
			android:layout_marginBottom="@dimen/splash_art_overhang"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_art_river"/>

		<ImageView
			android:id="@+id/art_foreground"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginLeft="@dimen/splash_art_overhang"
			android:layout_marginTop="@dimen/splash_art_overhang"
			android:layout_marginRight="@dimen/splash_art_overhang"
			android:layout_marginBottom="@dimen/splash_art_overhang"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_art_foreground"/>

	</FrameLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:orientation="vertical">
		
		<!-- masto.nyc fork: the mark on its own, with the name set in type under it. The artwork
		     is the full 5BFP lockup, mark and the word "5BFP" together; splash_mark_5bfp is the
		     mark cropped out of it by tools/artwork/splash_mark.py. Dark text, because this sits
		     over the pale sky at the top of the art. -->
		<ImageView
			android:layout_width="wrap_content"
			android:layout_height="104dp"
			android:adjustViewBounds="true"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="32dp"
			android:importantForAccessibility="no"
			android:src="@drawable/splash_mark_5bfp"/>

		<org.joinmastodon.android.fork.OutlinedTextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="8dp"
			android:text="@string/app_name"
			android:textColor="#1A1A1A"
			android:textSize="34sp"
			android:textStyle="bold"
			app:outlineColor="#FFFFFF"
			app:outlineWidth="3dp"/>

		<org.joinmastodon.android.fork.OutlinedTextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="2dp"
			android:importantForAccessibility="no"
			android:text="@string/splash_byline"
			android:textColor="#1A1A1A"
			android:textSize="13sp"
			app:outlineColor="#FFFFFF"
			app:outlineWidth="2dp"/>

		<Space
			android:layout_width="1px"
			android:layout_height="0px"
			android:layout_weight="1"/>

		<org.joinmastodon.android.ui.views.ProgressBarButton
			android:id="@+id/btn_join_default_server"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:layout_marginRight="16dp"
			style="@style/Widget.Mastodon.M3.Button.Filled"
			tools:text="@string/join_default_server"/>

		<Button
			android:id="@+id/btn_log_in"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:layout_marginRight="16dp"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="8dp"
			android:textColor="#FFF"
			style="@style/Widget.Mastodon.M3.Button.Outlined"
			android:background="@drawable/bg_button_m3_outlined_white"
			android:text="@string/log_in"/>

	</LinearLayout>

</org.joinmastodon.android.ui.views.SizeListenerFrameLayout>